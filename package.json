{
  "name": "fouad-ai",
  "version": "0.1.0",
  "description": "Privacy-first bilingual local AI coding CLI",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.4",
  "bin": {
    "fouad": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "supabase",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "MODEL_LICENSES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pty": "vitest run tests/tui-pty.test.ts",
    "worker:types": "wrangler types --config worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "worker:check": "wrangler types --check --config worker/wrangler.jsonc worker/worker-configuration.d.ts && tsc -p worker/tsconfig.json --noEmit && vitest run worker/tests",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy:dry": "wrangler deploy --config worker/wrangler.jsonc --dry-run",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts",
    "web:clean": "node scripts/clean-web.mjs",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "platform:build:worker": "tsc -p apps/platform-worker/tsconfig.json --noEmit",
    "platform:build": "npm run web:clean && npm run web:build && npm run platform:build:worker",
    "platform:types": "wrangler types --config apps/platform-worker/wrangler.jsonc apps/platform-worker/worker-configuration.d.ts",
    "platform:check": "npm run web:typecheck && npm run web:build && tsc -p apps/platform-worker/tsconfig.json --noEmit && vitest run apps/platform-worker/tests",
    "platform:deploy:dry": "npm run platform:build && wrangler deploy --config apps/platform-worker/wrangler.jsonc --dry-run",
    "platform:deploy": "npm run platform:build && wrangler deploy --config apps/platform-worker/wrangler.jsonc",
    "admin:create": "node scripts/create-admin.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.57.4",
    "commander": "^14.0.0",
    "ink": "^6.2.3",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "marked": "^16.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  }
}
